# Copy this file to .env (never commit .env) before running `npm run db:up`
# or `make db-up`. See docs/database-setup.md for the full setup guide.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=wms
POSTGRES_USER=postgres
# Superuser password for local dev only — change this for anything beyond localhost.
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Created by infra/postgres/init/03-roles.sh on first container boot.
# wms_app: read/write, used by the application at runtime (see DATABASE_URL).
# wms_readonly: read-only, for reporting/BI tools.
WMS_APP_PASSWORD=change-me-app-password
WMS_READONLY_PASSWORD=change-me-readonly-password

# What application code (infrastructure/database/PostgresInventoryRepository
# etc. — see ARCHITECTURE.md) connects with. Authenticates as wms_app, not
# the postgres superuser.
DATABASE_URL=postgresql://wms_app:change-me-app-password@localhost:5432/wms

# ---------------------------------------------------------------------------
# WMS API (infrastructure/adapters/http — `npm run serve`)
# ---------------------------------------------------------------------------
HTTP_PORT=3000

# ---------------------------------------------------------------------------
# Supabase (local self-hosted stack: Studio, Auth, Realtime, PostgREST, Storage)
# ---------------------------------------------------------------------------
# Must be at least 32 characters. Generate your own with:
#   openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# The two well-known Supabase local-dev demo keys (JWTs signed with the
# JWT_SECRET above, for the "anon" and "service_role" roles respectively —
# see Supabase's official self-hosting guide). They only work together with
# the exact JWT_SECRET above; if you change JWT_SECRET, regenerate both at
# https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# (or with the `supabase` CLI) rather than editing these strings by hand.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Base URL application code and supabase-js should treat as "Supabase".
# Points directly at PostgREST — there is no Kong API gateway in this
# lean local setup, so Auth/Realtime/Storage are reached on their own
# ports below instead of under /auth/v1, /realtime/v1, /storage/v1 on this
# same URL. See docs/database-setup.md "Known limitations".
SUPABASE_URL=http://localhost:3001

# Random 64+ character secret required by the Realtime service.
# Generate your own with:
#   openssl rand -base64 48
REALTIME_SECRET_KEY_BASE=change-me-to-a-random-64-character-or-longer-string-before-first-boot

# Ports for the services not covered by DATABASE_URL/SUPABASE_URL above.
STUDIO_PORT=54323
AUTH_PORT=9999
REST_PORT=3001
REALTIME_PORT=4000
STORAGE_PORT=5000

# External URLs Auth uses when generating confirmation/redirect links.
GOTRUE_EXTERNAL_URL=http://localhost:9999
GOTRUE_SITE_URL=http://localhost:3000

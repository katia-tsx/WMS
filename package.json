{
  "name": "ai-powered-wms",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered Warehouse Management System, scaffolded with Hexagonal Architecture (Ports and Adapters).",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test",
    "serve": "node infrastructure/adapters/http/main.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f",
    "db:migrate": "bash infra/migrations/migrate.sh up",
    "db:migrate:down": "bash infra/migrations/migrate.sh down",
    "db:migrate:status": "bash infra/migrations/migrate.sh status"
  },
  "devDependencies": {
    "eslint": "^9.9.0"
  }
}
